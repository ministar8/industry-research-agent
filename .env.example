# ============================================================
# LLM providers
# At least one LLM key is required, otherwise the service refuses to start.
# Default routes the LLM through DashScope (deepseek-v4.1-flash, thinking off).
# Set DEFAULT_MODEL=deepseek-flash to use DeepSeek's own endpoint instead.
# ============================================================
# DeepSeek. Always required: Search/Fetch retrieval uses this key.
# Also serves as the LLM fallback when DASHSCOPE_API_KEY is absent.
DEEPSEEK_API_KEY=

# Alibaba Model Studio (DashScope): hosts deepseek-v4.1-flash and qwen3.8-27b.
# Set DEFAULT_MODEL to one of them to route the LLM through DashScope.
DASHSCOPE_API_KEY=
# Legacy endpoint; switch to https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# once your workspace has migrated.
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DashScope-hosted DeepSeek: thinking must stay OFF. thinking_budget was ignored at
# 4096 and the call still hit the completion ceiling, so "on" is not usable here.
# DASHSCOPE_ENABLE_THINKING=false
# DASHSCOPE_THINKING_BUDGET=4096

OPENAI_API_KEY=

# Use a fake model to verify plumbing without calling a provider
USE_FAKE_MODEL=false

# Override the default model. Options: deepseek-flash | deepseek-v4.1-flash | qwen3.8-27b
DEFAULT_MODEL=

# Any OpenAI-compatible endpoint (vLLM / SGLang / internal gateway)
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# ============================================================
# Web server
# ============================================================
HOST=0.0.0.0
PORT=8080

# Trusted proxy IPs for X-Forwarded-* headers. Behind a reverse proxy (Render, nginx,
# Docker) set "*" so the public scheme/host reach the app; the cookie-auth Origin
# check rejects HTTPS POSTs when the request still looks like internal HTTP.
FORWARDED_ALLOW_IPS=127.0.0.1

# Application mode. "dev" enables uvicorn reload.
MODE=

# Authentication secret, HTTP bearer token header is required if set.
# WARNING: If unset, all API endpoints are unauthenticated. Always set this in production.
AUTH_SECRET=

# User authentication. Generate a long random value for production.
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Set true when serving over HTTPS.
AUTH_COOKIE_SECURE=true

# ============================================================
# Checkpoint store (conversation history + long-term memory)
# ============================================================
# postgres is the local default; sqlite and mongo remain available explicitly.
DATABASE_TYPE=postgres

# If DATABASE_TYPE=sqlite (Optional)
SQLITE_DB_PATH=checkpoints.db

# If DATABASE_TYPE=postgres
# Local: docker compose up -d postgres
# POSTGRES_HOST=localhost for host runs; compose overrides it to the postgres service name.
# Windows: hot reload is unavailable with PostgreSQL (psycopg needs a Selector loop)
POSTGRES_USER=postgres
# Replace with a local-only password before starting Docker Compose.
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_service
# POSTGRES_APPLICATION_NAME="industry-research-agent"
# POSTGRES_MIN_CONNECTIONS_PER_POOL=1
# POSTGRES_MAX_CONNECTIONS_PER_POOL=3

# If DATABASE_TYPE=mongo
MONGO_HOST=
MONGO_PORT=
MONGO_DB=
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_AUTH_SOURCE=
# MONGO_TLS=false
