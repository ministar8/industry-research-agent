FROM python:3.13.14-slim

WORKDIR /app

ENV UV_PROJECT_ENVIRONMENT="/usr/local/"
ENV UV_COMPILE_BYTECODE=1

COPY pyproject.toml .
COPY uv.lock .
RUN pip install --no-cache-dir --upgrade "pip>=26.2.2" && pip install --no-cache-dir uv==0.13.5
RUN uv sync --frozen --no-install-project --no-dev

RUN groupadd --system app && useradd --system --gid app --home-dir /app --no-create-home app

COPY --chown=app:app src/agents/ ./agents/
COPY --chown=app:app src/auth/ ./auth/
COPY --chown=app:app src/core/ ./core/
COPY --chown=app:app src/memory/ ./memory/
COPY --chown=app:app src/schema/ ./schema/
COPY --chown=app:app src/service/ ./service/
COPY --chown=app:app src/run_service.py .
COPY --chown=app:app static/ /static/
COPY --chown=app:app prompts/ /prompts/

USER app
CMD ["python", "run_service.py"]
